# ─── BYZCARD environment ──────────────────────────────────────────────
# Copy to .env.local for development. Never commit real values.

# Canonical origin. Drives share URLs, QR content, NFC payloads, Wallet QR.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: public repository link shown on the homepage. When unset it
# defaults to https://github.com/NeerajMohanty/byzcard; set it to an empty
# string to hide the GitHub links entirely, or to another valid
# https://github.com/... URL (e.g. a fork) to override the default.
NEXT_PUBLIC_GITHUB_URL=

# ─── Apple Wallet (optional — feature hidden when absent) ─────────────
# Requires an Apple Developer Program membership, a registered Pass Type ID,
# and its certificate. See docs/WALLET_SETUP.md.
# Provide PEM content inline (\n-escaped) OR a file path — file path wins.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_CERT_PEM_FILE=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PEM_FILE=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM=
APPLE_WWDR_CERT_PEM_FILE=

# ─── Google Wallet (optional — feature hidden when absent) ────────────
# Requires a Google Wallet issuer account and a GCP service account key.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY_PEM=
GOOGLE_WALLET_SA_KEY_PEM_FILE=
